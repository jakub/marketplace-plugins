{
  "description": "flow for Codex: ordered charter injection plus no-backlog, git, publish and protected-file guards.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/inject-charter-codex.mjs\"",
            "timeout": 5,
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/no-backlog-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/git-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/publish-guard-codex.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/protect-files-codex.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
