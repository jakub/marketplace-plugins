{
  "description": "flow for Codex: charter injection at session and subagent start, plus no-backlog, git, publish and protected-file guards.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/inject-charter.mjs\" session codex",
            "timeout": 5,
            "additionalContextLimit": 8000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/inject-charter.mjs\" subagent codex",
            "timeout": 5,
            "additionalContextLimit": 3000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/no-backlog-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/git-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/publish-guard-codex.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/protect-files-codex.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
