[Unit]
Description=flow nightly lint: label contract, worktrees, branches, known flakes
# No network-online dependency: that target is a no-op in the user manager. The
# jobs fail closed instead — a failed fetch means nothing buckets safe and the
# report says so.
[Service]
Type=oneshot
EnvironmentFile=-%h/.config/flow/cron.env
ExecStart=%h/.local/libexec/flow-cron lint
TimeoutStartSec=50min
UMask=0077
NoNewPrivileges=true
